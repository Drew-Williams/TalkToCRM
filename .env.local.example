# Talk to CRM — extension client env
#
# Copy this file to `.env.local` and fill in the real values. `.env.local` is
# gitignored and Vite only exposes vars prefixed `VITE_` to client code, but
# remember that ANYTHING in this file still ships inside the built extension
# bundle (dist/) and is readable by anyone who unpacks the .crx. That means:
#
#   ✅ safe here: Supabase project URL, Supabase ANON key, ElevenLabs agent ID
#   ❌ NEVER put here: Supabase service role key, ElevenLabs API key
#
# Those secrets belong ONLY to the Supabase edge functions (server side),
# configured via `supabase secrets set ...` once the first edge function
# exists (step 2). They are never read by the extension client.

# New Supabase project (separate from salesplaybookbuilder-ai — do not share)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# New ElevenLabs agent (fresh agent, not the voice-agent-site agent)
VITE_ELEVENLABS_AGENT_ID=your-agent-id-here
